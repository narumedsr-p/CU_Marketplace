generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model ChatRoom {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @map("room_id") @db.Uuid
  participant1 String        @map("participant_1") @db.Uuid
  participant2 String        @map("participant_2") @db.Uuid
  itemId       String        @map("item_id") @db.Uuid
  isBlocked    Boolean       @default(false) @map("is_blocked")
  messages     ChatMessage[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
}

model ChatMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("message_id") @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  room        ChatRoom @relation(fields: [roomId], references: [id])
  senderId    String?  @map("sender_id") @db.Uuid
  content     String
  isSystemMsg Boolean  @default(false) @map("is_system_msg")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}
