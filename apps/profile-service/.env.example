PROFILE_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/cu_profile_db?schema=public"
PROFILE_PORT=3006
PROFILE_GRPC_PORT=4006

JWT_SECRET="dev-secret-change-me"
JWT_ISSUER="cu-marketplace-auth"

# Google OAuth (real login, gated to ALLOWED_EMAIL_DOMAIN) — get these from
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# with GOOGLE_CALLBACK_URL added as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3006/auth/google/callback"
ALLOWED_EMAIL_DOMAIN="chula.ac.th"
FRONTEND_URL="http://localhost:5173"
