generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Wishlist {
  id        String   @id @default(uuid()) @map("wishlist_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model MatchRule {
  id         String        @id @default(uuid()) @map("rule_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  keyword    String
  minScore   Decimal       @default(0.5) @map("min_score") @db.Decimal(5, 4)
  isActive   Boolean       @default(true) @map("is_active")
  matches    MatchRecord[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
}

model MatchRecord {
  id            String    @id @default(uuid()) @map("match_id") @db.Uuid
  ruleId        String    @map("rule_id") @db.Uuid
  rule          MatchRule @relation(fields: [ruleId], references: [id])
  matchedItemId String    @map("matched_item_id") @db.Uuid
  matchScore    Decimal   @map("match_score") @db.Decimal(5, 4)
  isNotified    Boolean   @default(false) @map("is_notified")
  matchedAt     DateTime  @default(now()) @map("matched_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
}
