generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  Active
  Banned
  Deleted
}

enum UserRole {
  Student
  Admin
}

enum ReportTargetType {
  User
  Item
  Chat
}

enum ReportStatus {
  Pending
  Reviewed
  Action_Taken
}

model UserProfile {
  userId        String        @id @map("user_id")
  displayName   String        @map("display_name")
  avatarUrl     String        @map("avatar_url")
  contactInfo   String        @map("contact_info")
  accountStatus AccountStatus @default(Active) @map("account_status")
  role          UserRole      @default(Student) @map("role")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
}

model Report {
  id         String           @id @default(uuid()) @map("report_id") @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetId   String           @map("target_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  reason     String
  status     ReportStatus     @default(Pending)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
}

model AuditLog {
  id        String   @id @default(uuid()) @map("log_id") @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
