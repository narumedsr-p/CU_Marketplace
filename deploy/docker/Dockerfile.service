FROM node:22-slim AS base
RUN npm install -g pnpm@10 turbo@1

FROM base AS pruner
ARG APP_NAME
WORKDIR /app
COPY . .
RUN turbo prune ${APP_NAME} --docker

FROM base AS installer
ARG APP_NAME
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY patches/ ./patches/
RUN if ! grep -q "@prisma/dev" pnpm-lock.yaml; then \
      sed -i '/^patchedDependencies:/,+1d' pnpm-workspace.yaml; \
    fi
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./
ENV CATALOG_DATABASE_URL="postgresql://user:pass@localhost:5432/db" \
    ORDER_DATABASE_URL="postgresql://user:pass@localhost:5432/db" \
    WISHLIST_DATABASE_URL="postgresql://user:pass@localhost:5432/db" \
    REVIEW_DATABASE_URL="postgresql://user:pass@localhost:5432/db" \
    PROFILE_DATABASE_URL="postgresql://user:pass@localhost:5432/db"
RUN turbo run build --filter=${APP_NAME}
RUN if ! grep -q "@prisma/dev" pnpm-lock.yaml; then \
      sed -i '/^patchedDependencies:/,+1d' pnpm-workspace.yaml; \
    fi
RUN CI=true pnpm install --prod --frozen-lockfile

FROM node:22-slim AS runner
ARG APP_NAME
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=installer /app .
WORKDIR /app/apps/${APP_NAME}
ENV APP_DIR=/app/apps/${APP_NAME}
CMD ["sh", "-c", "node $APP_DIR/dist/main.cjs"]
